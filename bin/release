#!/usr/bin/env ruby
require 'digest'
require 'fileutils'
require 'open3'

class ReleaseBuilder
  VERSION = '1.0.1'.freeze
  TAG = "v#{VERSION}".freeze
  ROOT = File.expand_path('..', __dir__).freeze
  OUTPUT = File.join(ROOT, 'macos/build/release').freeze
  ASSET = "AgentManager-#{VERSION}-macos-arm64.zip".freeze

  def build
    abort 'Build this release on Apple Silicon.' unless capture('uname', '-m').strip == 'arm64'
    run('xcodebuild', '-project', 'macos/AgentManager.xcodeproj', '-scheme', 'AgentManager',
        '-configuration', 'Release', '-derivedDataPath', 'macos/build', 'build')
    app = File.join(ROOT, 'macos/build/Build/Products/Release/AgentManager.app')
    version = capture('/usr/libexec/PlistBuddy', '-c', 'Print :CFBundleShortVersionString', "#{app}/Contents/Info.plist").strip
    abort "Unexpected app version: #{version}" unless version == VERSION
    binary = "#{app}/Contents/MacOS/AgentManager"
    abort 'Expected arm64 executable' unless capture('lipo', '-archs', binary).strip == 'arm64'
    abort 'Missing bundled licenses' unless File.file?("#{app}/Contents/Resources/Licenses/ThirdParty/licenses/z2d/COPYING")
    run('codesign', '--verify', '--deep', '--strict', app)
    FileUtils.mkdir_p(OUTPUT)
    stage = File.join(OUTPUT, 'package')
    FileUtils.rm_rf(stage)
    FileUtils.mkdir_p(stage)
    run('ditto', app, "#{stage}/AgentManager.app")
    File.write("#{stage}/INSTALL.txt", <<~TEXT)
      Agent Manager #{VERSION} for Apple Silicon Macs (macOS 13 or newer)

      Install tmux before launching: brew install tmux
      Move AgentManager.app to Applications, then open it.
      This build is ad hoc signed, not Developer ID signed or notarized.
      macOS may require explicit approval to open an app downloaded from GitHub.
      Licenses and third-party source notices are in Agent Manager > Licenses….

      Source: https://github.com/jeffmcfadden/agent-manager
    TEXT
    archive = File.join(OUTPUT, ASSET)
    FileUtils.rm_f(archive)
    run('ditto', '-c', '-k', '--sequesterRsrc', stage, archive)
    File.write(File.join(OUTPUT, 'SHA256SUMS'), "#{Digest::SHA256.file(archive).hexdigest}  #{ASSET}\n")
    File.write(File.join(OUTPUT, 'release-notes.md'), <<~TEXT)
      Agent Manager 1.0.1: native AppKit terminal session management, powered by
      libghostty and persistent tmux sessions.

      - Command-W now ends the visible session after confirmation and keeps the window open.
      - **Apple Silicon only; macOS 13 or newer.**
      - Download `#{ASSET}`, unzip, and move `AgentManager.app` to Applications.
      - **Requires tmux:** install it with `brew install tmux` before launching.
      - Ad hoc signed; not Developer ID signed or notarized. macOS may require
        explicit approval on first launch.
      - Original application code uses WTFPL v2. Third-party licenses and z2d
        source are bundled under **Agent Manager → Licenses…**.

      `SHA256SUMS` contains the ZIP checksum.
    TEXT
    puts "Release package: #{archive}"
  end

  def publish
    run('gh', 'auth', 'status')
    abort 'Commit the release source changes before publishing.' unless capture('git', 'status', '--porcelain').strip.empty?
    target = capture('git', 'rev-parse', 'HEAD').strip
    run('git', '-c', 'credential.helper=', '-c', 'credential.helper=!gh auth git-credential', 'push', 'origin', 'HEAD')
    run('gh', 'release', 'create', TAG, File.join(OUTPUT, ASSET), File.join(OUTPUT, 'SHA256SUMS'),
        '--repo', 'jeffmcfadden/agent-manager', '--target', target, '--title', VERSION,
        '--notes-file', File.join(OUTPUT, 'release-notes.md'), '--latest')
  end

  def run(*arguments)
    abort "Command failed: #{arguments.join(' ')}" unless system(*arguments)
  end

  def capture(*arguments)
    output, status = Open3.capture2(*arguments)
    abort "Command failed: #{arguments.join(' ')}" unless status.success?
    output
  end
end

Dir.chdir(ReleaseBuilder::ROOT) do
  abort 'Usage: ruby bin/release [--publish | --upload-only]' unless ARGV.empty? || [%w[--publish], %w[--upload-only]].include?(ARGV)
  release = ReleaseBuilder.new
  release.build unless ARGV == ['--upload-only']
  release.publish unless ARGV.empty?
end
