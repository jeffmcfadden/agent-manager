#!/usr/bin/env ruby
require 'fileutils'
Dir.chdir(File.expand_path('..', __dir__))
FileUtils.mkdir_p('.cache')
abort 'Test compile failed' unless system('xcrun', 'swiftc', '-swift-version', '5',
  '-module-cache-path', '.cache/swift-modules', 'Sources/TmuxBackend.swift',
  'Tests/TmuxBackend/main.swift', '-o', '.cache/test-tmux')
exec('.cache/test-tmux')
